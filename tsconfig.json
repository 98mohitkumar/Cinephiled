{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["DOM", "DOM.Iterable", "ESNext", "webworker"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "components/*": ["./src/components/*"],
      "images/*": ["./public/images/*"],
      "public/*": ["./public/*"],
      "styles/*": ["./src/styles/*"],
      "theme/*": ["./src/theme/*"],
      "data/*": ["./src/data/*"],
      "hooks/*": ["./src/hooks/*"],
      "apiRoutes/*": ["./src/apiRoutes/*"],
      "Store/*": ["./src/Store/*"],
      "tokens/*": ["./src/theme/tokens/*"],
      "utils/*": ["./src/utils/*"],
      "api/*": ["./src/pages/api/*"]
    },
    "types": ["@serwist/next/typings"],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "styled.d.ts", "**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules", "public/*.js"]
}
